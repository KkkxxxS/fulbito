# Plantilla de variables de entorno para fulbito.
# Copialo a `.env` (en la raíz del repo) y completá los valores. `.env` está
# en .gitignore: NUNCA lo commitees.

# Postgres gestionada (Neon / Supabase / Render). Sin esta variable el server
# usa SQLite local (server/data/historial.db). Ejemplo:
# DATABASE_URL=postgresql://user:pass@host:5432/fulbito?sslmode=require

# Requerida para generar pronósticos (API externa de football-data.org)
# FOOTBALL_DATA_API_KEY=tu_clave

# Protege las escrituras de /api/historial (X-Api-Key). Requerida en producción.
# HISTORIAL_API_KEY=cambia_esto

# Puerto del server (Render la inyecta sola; para local usá 3000)
# PORT=3000