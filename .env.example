# Plantilla de variables de entorno para fulbito.
# Copialo a `.env` (en la raíz del repo) y completá los valores. `.env` está
# en .gitignore: NUNCA lo commitees.

# Postgres gestionada (Neon / Supabase / Render). Es REQUERIDA para cuentas
# (registro/login) e historial personal. Sin DATABASE_URL el server sigue
# sirviendo pronósticos e historial global con SQLite local
# (server/data/historial.db), pero /api/auth y /api/mi-historial responden 503.
# DATABASE_URL=postgresql://user:pass@host:5432/fulbito?sslmode=require
#
# Para Postgres local sin TLS (o el servicio de CI) desactivá SSL:
# DATABASE_SSL=false

# Directorio de datos locales (SQLite/ELO). Por defecto server/data.
# Los tests usan un directorio temporal; no hace falta configurarlo.
# FULBITO_DATA_DIR=

# Requerida para generar pronósticos (API externa de football-data.org)
FOOTBALL_DATA_API_KEY=tu_clave

# Requerida para múltiples deportes y cuotas (The Odds API)
# THE_ODDS_API_KEY=tu_clave_de_the_odds_api

# Protege las escrituras de /api/historial (X-Api-Key). Requerida en producción.
# HISTORIAL_API_KEY=cambia_esto

# Orígenes CORS extra separados por coma (previews o dominio propio).
# Ejemplo: CORS_ORIGINS=https://fulbito.app,https://fulbito-preview.vercel.app
# CORS_ORIGINS=

# Puerto del server (Render la inyecta sola; para local usá 3000)
# PORT=3000