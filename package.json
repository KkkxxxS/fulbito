{
  "name": "fulbito",
  "version": "1.0.0",
  "description": "Pronósticos de fútbol basados en un modelo estadístico (Poisson + Dixon-Coles)",
  "private": true,
  "scripts": {
    "start": "cd server && node server.js",
    "dev": "cd server && node --watch server.js",
    "test": "python test_recalibracion.py",
    "test:parity": "python test_paridad.py",
    "test:server": "node server/test-persistence.js",
    "test:auth": "node server/test-auth.js",
    "test:utils": "node test-frontend-utils.js",
    "verify": "node verify-model.js",
    "smoke": "node smoke-frontend.js",
    "check": "node -c app-model.js && node -c app-ui.js && node -c app-init.js && node -c app-animaciones.js && node -c menu-toggle.js && node -c sw.js && node -c v-multideporte.js && node -c server/server.js && node -c verify-model.js"
  },
  "keywords": [
    "futbol",
    "pronosticos",
    "poisson",
    "dixon-coles",
    "estadistica"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "motion": "^13.4.4",
    "pg": "^8.23.1"
  }
}
